// OptiPrompt — schema do banco de dados
// 1 crédito = R$ 0,001 de custo real nas APIs (ver src/lib/credits/credit-converter.ts)

generator client {
  provider = "prisma-client-js"
}

// A connection string vive em prisma.config.ts (Migrate/Studio) e é passada
// via driver adapter ao PrismaClient em runtime — ver src/lib/db/prisma.ts.
datasource db {
  provider = "postgresql"
}

enum Provider {
  OPENAI
  ANTHROPIC
  GOOGLE
  MARITACA
  /// Mantido só por compatibilidade com execuções históricas — GPT-OSS e
  /// Llama estavam agrupados aqui visualmente (por rodarem na Groq via
  /// OpenRouter), mas o fabricante real é OpenAI/Meta. Nenhum modelo novo
  /// usa esse valor (ver comentário em types/models.ts).
  GROQ
  DEEPSEEK
  MISTRAL
  META
}

enum ModelTier {
  PREMIUM
  COST_EFFECTIVE
}

enum ExecutionStatus {
  SUCCESS
  ERROR
}

/// Veredito de uma regra opcional definida pelo usuário (ex.: "a resposta
/// não pode dizer que é uma IA") — avaliado por um modelo-juiz depois da
/// resposta principal, ver src/lib/ai/rule-checker.ts.
enum RuleVerdict {
  PASSED
  FAILED
}

/// Provedor de IA cujo saldo é recarregado com a fatia da receita de
/// assinaturas — ver src/lib/credits/provider-allocation.ts.
enum CreditProvider {
  ANTHROPIC
  GOOGLE
  MARITACA
}

enum CreditAllocationStatus {
  PENDING
  COMPLETED
}

/// Espelha os status de assinatura do Stripe — ver src/lib/stripe.
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INACTIVE
}

model Plan {
  id                      String   @id @default(cuid())
  name                    String   @unique
  slug                    String   @unique
  /// Preço da assinatura em centavos. O teto mensal de créditos é derivado
  /// daqui (20% do valor) — ver getMonthlyCreditLimit em credit-converter.ts.
  priceInCents            Int
  /// Sobrescreve o teto mensal de créditos calculado a partir do preço —
  /// usado pelo plano "Gratuito" (ver src/lib/plans/trial.ts), que tem
  /// priceInCents 0 mas precisa de um teto próprio (300 créditos). null em
  /// todos os planos pagos, que continuam derivando do preço normalmente.
  fixedMonthlyCreditLimit Int?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  users User[]

  @@map("plans")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String?
  /// Hash bcrypt — null só para linhas legadas anteriores ao login real.
  passwordHash       String?
  /// Senha provisória definida pelo admin (ver admin/usuarios) — força a
  /// troca no próximo acesso antes de liberar qualquer rota de /app.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  planId String?
  plan   Plan?   @relation(fields: [planId], references: [id])

  // Consumo do ciclo mensal atual, em créditos (saldo = teto do plano - isto)
  creditsUsedThisCycle Int      @default(0)
  cycleStartedAt       DateTime @default(now())

  /// Créditos avulsos comprados (pagamento único, fora da assinatura) — somam
  /// ao teto do ciclo e NÃO vencem/resetam (ver getUsageSummary). Diferente
  /// de creditsUsedThisCycle, que é sobre consumo do plano recorrente.
  bonusCredits Int @default(0)

  // Assinatura (Stripe) — ver src/lib/stripe e middleware.ts.
  subscriptionStatus   SubscriptionStatus @default(INACTIVE)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique

  /// Cancelamento agendado pro fim do ciclo pago atual (ver
  /// src/app/api/stripe/cancel-subscription/route.ts) — enquanto true, o
  /// usuário mantém acesso e os créditos do plano até currentPeriodEnd, mas
  /// não pode comprar pacotes avulsos (ver checkout-credits/route.ts).
  cancelAtPeriodEnd Boolean   @default(false)
  currentPeriodEnd  DateTime?

  /// Prazo do plano "Gratuito" criado pelo admin (ver src/lib/plans/trial.ts
  /// e src/lib/auth/expire-trial.ts) — passado esse prazo, a conta perde o
  /// plano (planId vira null, subscriptionStatus vira INACTIVE) na próxima
  /// vez que ela acessar /app, forçando a escolha de uma assinatura paga.
  /// null em toda conta que nunca teve o plano Gratuito.
  trialEndsAt DateTime?

  /// Confirmação de e-mail (ver src/lib/email) — exigida só pra rodar a
  /// execução diária do plano Free (proteção contra abuso por contas
  /// descartáveis), não bloqueia login nem o resto do app. null até o
  /// usuário clicar no link do e-mail de verificação.
  emailVerifiedAt DateTime?

  /// Timestamp da última execução BEM-SUCEDIDA do plano Free (ver
  /// src/lib/plans/free-tier.ts) — só sucesso atualiza este campo; uma
  /// falha exclusiva do provedor não consome a cota diária. null até a
  /// primeira execução.
  freeExecutionUsedAt DateTime?

  /// Chave OpenRouter provisionada automaticamente pra esta conta (ver
  /// src/lib/openrouter/client.ts) — todas as execuções desse usuário usam
  /// essa chave, com teto de gasto (`limit`) espelhando creditsTotal como
  /// trava de segurança por baixo do sistema de créditos interno.
  openRouterKeyHash String? @unique
  openRouterApiKey  String? @unique

  /// Conta colaboradora de um projeto dentro de uma agência Enterprise (ver
  /// src/app/app/projects) — quando setado, plano/assinatura/créditos dessa
  /// conta resolvem pro dono do projeto (ver getBillingOwnerId), não pra ela
  /// mesma. Histórico é compartilhado só entre colaboradores do mesmo
  /// projeto (ver listExecutionsForProject) — projetos são isolados entre
  /// si. onDelete: Cascade porque uma conta colaboradora só existe dentro do
  /// projeto dela; apagar o projeto apaga os logins criados nele.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Projetos criados por esta conta quando ela é a dona de uma assinatura
  /// Enterprise (ver src/app/app/projects) — uma conta colaboradora
  /// (projectId setado) não cria projetos (hierarquia de 1 nível).
  ownedProjects Project[] @relation("ProjectOwner")

  prompts                   Prompt[]
  executions                Execution[]
  providerCreditAllocations ProviderCreditAllocation[]
  creditPackPurchases       CreditPackPurchase[]
  workflowProjects          WorkflowProject[]
  emailVerificationTokens   EmailVerificationToken[]
  freeExecutionAttempts     FreeExecutionAttempt[]
  productEvents             ProductEvent[]
  benchmarksCreated         Benchmark[]
  benchmarkRunsCreated      BenchmarkRun[]

  @@map("users")
}

/// Projeto visual de automação criado pelo usuário. O grafo é armazenado
/// como JSON para preservar posições e configurações do React Flow.
model WorkflowProject {
  id        String   @id @default(cuid())
  name      String
  nodes     Json
  edges     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs      WorkflowRun[]

  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
  @@map("workflow_projects")
}

/// Snapshot de uma execução completa do workflow. Mantém o grafo utilizado
/// para que o histórico continue reproduzível após edições posteriores.
model WorkflowRun {
  id             String    @id @default(cuid())
  status         String
  nodesSnapshot  Json
  edgesSnapshot  Json
  finalOutput    String?   @db.Text
  errorMessage   String?   @db.Text
  totalCredits   Int       @default(0)
  totalLatencyMs Int       @default(0)
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  workflowId String
  workflow   WorkflowProject   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  steps      WorkflowStepRun[]

  @@index([workflowId, createdAt])
  @@map("workflow_runs")
}

/// Resultado auditável de cada bloco em uma execução.
model WorkflowStepRun {
  id                     String   @id @default(cuid())
  nodeId                 String
  kind                   String
  label                  String
  modelId                String?
  status                 String
  inputText              String?  @db.Text
  outputText             String?  @db.Text
  errorMessage           String?  @db.Text
  promptTokens           Int      @default(0)
  completionTokens       Int      @default(0)
  latencyMs              Int      @default(0)
  estimatedCostInCredits Int      @default(0)
  estimatedCostInBRL     Decimal  @default(0) @db.Decimal(10, 6)
  position               Int
  createdAt              DateTime @default(now())

  runId String
  run   WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, position])
  @@map("workflow_step_runs")
}

/// Projeto de uma agência — agrupa histórico, workflows, benchmarks e (só
/// no plano Enterprise) colaboradores em torno de um cliente. Criação é
/// liberada pra qualquer plano ativo (ver src/app/app/projects/actions.ts);
/// só o recurso de colaboradores (múltiplos logins por projeto, ver
/// listExecutionsForProject) continua exclusivo do Enterprise. Colaboradores
/// de projetos diferentes do mesmo dono não veem o histórico uns dos
/// outros; só o dono vê tudo agregado (ver listExecutionsForTeam).
model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  members          User[]
  workflowProjects WorkflowProject[]

  benchmarks Benchmark[]

  @@index([ownerId])
  @@map("projects")
}

model Prompt {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  executions Execution[]

  @@index([userId])
  @@map("prompts")
}

/// Uma "execução" é um disparo de teste: o snapshot exato do prompt naquele
/// momento + os resultados retornados por cada modelo selecionado.
model Execution {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  promptId String
  prompt   Prompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Snapshot imutável do prompt no momento da execução (versionamento)
  systemPrompt String @db.Text
  userMessage  String @db.Text

  /// Regra opcional em texto livre, verificada em cada resposta por um
  /// modelo-juiz (ver src/lib/ai/rule-checker.ts) — null quando o usuário
  /// não definiu nenhuma pra essa execução.
  rule String? @db.Text

  results ExecutionResult[]

  @@index([userId])
  @@index([promptId])
  @@map("executions")
}

/// Histórico de recargas de antes da migração pro OpenRouter, quando cada
/// provedor de IA era pago separadamente — mantido só por compatibilidade
/// com dados antigos (ver /admin/creditos). Nenhuma linha nova é criada
/// desde a centralização (ver src/lib/openrouter/client.ts).
model ProviderCreditAllocation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// event.id do webhook do Stripe que originou esta alocação (idempotência).
  stripeEventId     String         @unique
  amountPaidInCents Int
  provider          CreditProvider
  amountInCents     Int

  status      CreditAllocationStatus @default(PENDING)
  completedAt DateTime?

  @@index([status])
  @@map("provider_credit_allocations")
}

/// Compra avulsa de créditos (pagamento único no Stripe, fora da assinatura
/// recorrente). Registro existe principalmente para idempotência — evita
/// creditar duas vezes se o Stripe reenviar o webhook.
model CreditPackPurchase {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// checkout.session.id do Stripe — único, garante que o mesmo pagamento
  /// nunca credita duas vezes mesmo com reentrega do webhook.
  stripeSessionId   String @unique
  amountPaidInCents Int
  creditsAdded      Int

  @@map("credit_pack_purchases")
}

model ExecutionResult {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  executionId String
  execution   Execution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  provider Provider
  modelId  String
  tier     ModelTier
  status   ExecutionStatus @default(SUCCESS)

  responseText String? @db.Text
  errorMessage String? @db.Text

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  latencyMs        Int @default(0)

  // Custo real (para o motor de créditos) — nunca exibido diretamente na UI
  estimatedCostInBRL     Decimal @db.Decimal(10, 6)
  estimatedCostInCredits Int

  /// Veredito da regra de Execution.rule pra esta resposta específica — null
  /// quando a execução não tinha regra ou quando este resultado deu ERROR
  /// (nada pra julgar).
  ruleVerdict RuleVerdict?
  ruleReason  String?      @db.Text

  @@index([executionId])
  @@map("execution_results")
}

/// Verificação de e-mail no cadastro (ver src/lib/email) — só bloqueia a
/// execução diária do plano Free, não o resto do app.
model EmailVerificationToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Lista configurável (via /admin/modelos) de quais modelos do MODEL_CATALOG
/// (src/types/models.ts) ficam disponíveis no plano Free — nunca hardcoded
/// no frontend (ver src/lib/plans/free-tier.ts). O `modelId` aqui é o mesmo
/// ID usado no catálogo estático (ex.: "openai/gpt-4o-mini"), não uma FK —
/// o catálogo em si continua vivendo só no código.
model FreeTierModel {
  id        String   @id @default(cuid())
  modelId   String   @unique
  active    Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("free_tier_models")
}

/// Log de toda tentativa de execução do plano Free, sucesso ou falha —
/// telemetria de abuso (ver src/lib/plans/free-tier.ts). Só uma tentativa
/// com succeeded=true consome a cota diária (User.freeExecutionUsedAt);
/// falha exclusiva do provedor não consome, mas fica registrada aqui.
model FreeExecutionAttempt {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  modelIds              String[]
  succeeded             Boolean
  providerErrorOccurred Boolean  @default(false)
  ipAddress             String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("free_execution_attempts")
}

/// Log mínimo de eventos de funil (calculadora, cadastro Free, upgrade
/// etc.) — não é uma plataforma de analytics, só uma tabela de log simples
/// pra medir ativação/conversão (ver src/lib/analytics/track-event.ts).
model ProductEvent {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name       String
  properties Json?

  createdAt DateTime @default(now())

  @@index([name])
  @@index([userId])
  @@map("product_events")
}

/// Um benchmark persistente: conjunto salvo de casos de teste + modelos +
/// critérios que pode ser reexecutado sempre que um prompt/modelo/workflow
/// mudar, pra comparar a nova versão com uma execução anterior (baseline) e
/// pegar regressão antes de publicar. Ver src/lib/benchmarks/run-benchmark.ts.
model Benchmark {
  id          String  @id @default(cuid())
  name        String
  description String? @db.Text
  taskType    String?

  /// Critérios qualitativos em texto livre (revisão manual) — v1 não tem
  /// tabela relacional própria por critério (ver plano de implementação).
  criteria String[] @default([])

  /// Limites usados pela comparação entre runs (ver src/lib/benchmarks/diff.ts).
  /// Todos opcionais: um benchmark sem limite configurado nunca reprova
  /// automaticamente, só informa as diferenças.
  minQualityScore           Int?
  maxQualityDropPoints      Int?
  maxCostIncreasePercent    Int?
  maxLatencyIncreasePercent Int?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Só atribuição/auditoria ("quem criou") — o dono real do ciclo de vida
  /// é o Project (já cascade acima). onDelete: SetNull porque apagar a
  /// conta de quem criou (ex.: remover um colaborador, ver
  /// removeCollaboratorUser) não pode derrubar o benchmark do cliente; ele
  /// só perde a atribuição.
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cases  BenchmarkCase[]
  models BenchmarkModel[]
  runs   BenchmarkRun[]

  @@index([projectId])
  @@map("benchmarks")
}

/// Um caso de teste dentro de um benchmark — um benchmark pode começar com
/// um caso só e crescer depois (não é obrigatório montar um dataset
/// completo antes de testar).
model BenchmarkCase {
  id          String    @id @default(cuid())
  benchmarkId String
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  systemPrompt String? @db.Text
  userMessage  String  @db.Text

  /// Imagem anexada, como data URL — mesmo formato usado no dashboard (ver
  /// prompt-editor-panel.tsx). Documento/PDF já chega aqui com o texto
  /// extraído concatenado em userMessage, igual ao fluxo do dashboard;
  /// só imagem precisa ser persistida à parte pra poder ser reenviada em
  /// cada reexecução do benchmark.
  attachedImageDataUrl String? @db.Text

  expectedWinnerModelId String?
  expectedResponse      String? @db.Text

  tags         String[] @default([])
  isAnonymized Boolean  @default(false)

  createdAt DateTime @default(now())

  results BenchmarkResult[]

  @@index([benchmarkId])
  @@map("benchmark_cases")
}

/// Modelo incluído no conjunto de comparação de um benchmark (ver
/// ModelSelector) — modelId é o mesmo ID do MODEL_CATALOG, não uma FK.
model BenchmarkModel {
  id          String    @id @default(cuid())
  benchmarkId String
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  modelId   String
  createdAt DateTime @default(now())

  @@unique([benchmarkId, modelId])
  @@map("benchmark_models")
}

/// Uma execução completa de um benchmark (todos os casos × todos os
/// modelos) — equivalente a "Execution", mas no nível de benchmark. Reusa o
/// mesmo motor de execução (runComparison/OpenRouterAdapter) caso a caso.
model BenchmarkRun {
  id          String    @id @default(cuid())
  benchmarkId String
  benchmark   Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  label      String?
  /// Marca esta run como a baseline atual do benchmark — no máximo uma
  /// por benchmark, garantido em código (ver run-benchmark.ts), não aqui.
  isBaseline Boolean @default(false)

  /// Só atribuição ("quem executou") — mesma razão do SetNull em
  /// Benchmark.createdByUserId acima.
  createdByUserId String?
  createdByUser   User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  results BenchmarkResult[]

  @@index([benchmarkId])
  @@map("benchmark_runs")
}

/// Resultado de um modelo pra um caso específico, dentro de uma run —
/// equivalente a "ExecutionResult", mesma forma de dado (ver to-dto.ts).
model BenchmarkResult {
  id             String       @id @default(cuid())
  benchmarkRunId String
  benchmarkRun   BenchmarkRun @relation(fields: [benchmarkRunId], references: [id], onDelete: Cascade)

  benchmarkCaseId String
  benchmarkCase   BenchmarkCase @relation(fields: [benchmarkCaseId], references: [id], onDelete: Cascade)

  provider Provider
  modelId  String
  tier     ModelTier
  status   ExecutionStatus @default(SUCCESS)

  responseText String? @db.Text
  errorMessage String? @db.Text

  promptTokens     Int @default(0)
  completionTokens Int @default(0)
  latencyMs        Int @default(0)

  costInBRL     Decimal @db.Decimal(10, 6)
  costInCredits Int

  /// Nota manual de qualidade (0-10) por revisão humana — v1 começa com
  /// revisão manual (ver Parte 3 do pedido); null até alguém revisar.
  manualQualityScore Int?

  /// Veredito do juiz de IA, quando o benchmark tem critério verificável
  /// por regra — mesmo mecanismo do rule-checker.ts, opcional.
  ruleVerdict RuleVerdict?
  ruleReason  String?      @db.Text

  createdAt DateTime @default(now())

  @@index([benchmarkRunId])
  @@index([benchmarkCaseId])
  @@map("benchmark_results")
}
