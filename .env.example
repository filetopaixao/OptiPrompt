# PostgreSQL — usado pelo Prisma (prisma/schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/optiprompt?schema=public"

# --- Chaves das APIs de IA (src/lib/ai/adapters/*) ---
# Sem a chave do provedor, os modelos daquele provedor retornam erro
# (capturado por BaseModelAdapter e exibido como card de erro na UI) — os
# demais provedores continuam funcionando normalmente.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
# Só necessário se ANTHROPIC_API_KEY for uma chave de organização (não
# escopada a um workspace) — nesse caso a API exige esse header.
ANTHROPIC_WORKSPACE_ID=""
GOOGLE_API_KEY=""
MARITACA_API_KEY=""
# Groq — inferência de alta velocidade para modelos open-weight (GPT-OSS).
# Não serve mais Llama 3 no self-serve — ver groq.adapter.ts.
GROQ_API_KEY=""

# --- Stripe (checkout + assinaturas — src/lib/stripe, src/app/api/stripe/*) ---
# Estrutura pronta, aguardando confirmação para instalar o pacote `stripe`.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_AGENCIA=""
