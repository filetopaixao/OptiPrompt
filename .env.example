# PostgreSQL — usado pelo Prisma (prisma/schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/optiprompt?schema=public"

# --- Autenticação (Auth.js/NextAuth — src/lib/auth) ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# E-mails com acesso ao painel interno /admin (separados por vírgula).
ADMIN_EMAILS=""

# --- OpenRouter (src/lib/openrouter, src/lib/ai/adapters/openrouter.adapter.ts) ---
# Toda chamada de modelo passa pelo OpenRouter — um só backend para OpenAI,
# Anthropic, Google e os modelos open-weight (GPT-OSS).
# Chave de inferência de fallback (dashboard > API Keys).
OPENROUTER_API_KEY=""
# Chave de gerenciamento (dashboard > Settings > Provisioning Keys) — usada
# só no servidor pra criar/atualizar a chave e o teto de gasto de cada
# usuário automaticamente (ver src/lib/openrouter/client.ts).
OPENROUTER_PROVISIONING_KEY=""

# --- Stripe (checkout + assinaturas — src/lib/stripe, src/app/api/stripe/*) ---
# Estrutura pronta, aguardando confirmação para instalar o pacote `stripe`.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID_STARTER=""
STRIPE_PRICE_ID_PRO=""
STRIPE_PRICE_ID_AGENCIA=""
# Pacote avulso de créditos — Price de pagamento único (mode "payment"),
# não de assinatura.
STRIPE_PRICE_ID_CREDIT_PACK=""
